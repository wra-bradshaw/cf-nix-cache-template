{
  "name": "cf-nix-cache-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "repository": "https://github.com/wra-bradshaw/cf-nix-cache-template",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "setup": "tsx scripts/deploy.mts setup",
    "deploy": "tsx scripts/deploy.mts deploy",
    "preview": "tsx scripts/deploy.mts preview",
    "doctor": "tsx scripts/deploy.mts doctor",
    "rotate-auth-key": "tsx scripts/rotate-auth-key.mts",
    "rotate-nix-key": "tsx scripts/rotate-nix-key.mts"
  },
  "cloudflare": {
    "bindings": {
      "CF_NIX_CACHE_BOOTSTRAP_SECRET": {
        "description": "Generate a one-time bootstrap value with at least 32 random characters, for example with `openssl rand -hex 32`."
      }
    }
  },
  "dependencies": {
    "cf-nix-cache": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.19.4",
    "typescript": "5.9.2",
    "wrangler": "4.120.1"
  }
}
