{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-nix-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CACHE_BUCKET",
      "bucket_name": "cf-nix-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SYSTEM_CONTROL", "class_name": "SystemControl" },
      { "name": "TOKEN_CATALOG", "class_name": "TokenCatalog" },
      { "name": "AUDIT_LOG", "class_name": "AuditLog" },
      { "name": "CACHE_COORDINATOR", "class_name": "CacheCoordinator" },
      { "name": "CACHE_INDEX", "class_name": "CacheIndexShard" },
      { "name": "UPLOAD_JOB", "class_name": "UploadJob" },
      { "name": "PROCESSOR", "class_name": "ProcessorContainer" },
      { "name": "GC_CONTROL", "class_name": "GcControl" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SystemControl",
        "TokenCatalog",
        "AuditLog",
        "CacheCoordinator",
        "CacheIndexShard",
        "UploadJob",
        "ProcessorContainer",
      ],
    },
    { "tag": "v2", "new_sqlite_classes": ["GcControl"] },
  ],
  "containers": [
    {
      "class_name": "ProcessorContainer",
      "scheduling_policy": "durable_object",
      // `pnpm run deploy` builds ./Dockerfile on top of the processor image
      // pinned by the installed cf-nix-cache release, and pushes it to this
      // account's container registry. PROCESSOR_IMAGE is kept in sync with
      // that release.
      "images": {
        "processor": {
          "dockerfile": "./Dockerfile",
          "build_vars": {
            "PROCESSOR_IMAGE": "docker.io/willlol/cf-nix-cache@sha256:3a98b62a71d53b5c5d2a8221a5f07037e9cc4ef3bf3cbaed8b3bafa4ec5e8580",
          },
        },
      },
    },
  ],
  "workflows": [
    {
      "name": "process-upload",
      "binding": "PROCESS_UPLOAD",
      "class_name": "ProcessUploadWorkflow",
    },
    {
      "name": "delete-cache",
      "binding": "DELETE_CACHE",
      "class_name": "DeleteCacheWorkflow",
    },
    {
      "name": "garbage-collect",
      "binding": "GARBAGE_COLLECT",
      "class_name": "GarbageCollectWorkflow",
      // Sundays at 03:00 UTC. Remove this line to run garbage collection only
      // on request.
      "schedules": ["0 3 * * 0"],
      "limits": { "steps": 25000 },
    },
  ],
  "vars": {
    "CF_NIX_CACHE_CONFIG_SCHEMA": "1",
    "TOKEN_ISSUER": "cf-nix-cache",
    "TOKEN_AUDIENCE": "cf-nix-cache",
    "NIX_SIGNING_KEY_NAME": "cache.nix-signing",
  },
  "observability": { "enabled": true },
  // A garbage collection run makes one request per index shard and manifest.
  "limits": { "subrequests": 10000000 },
}
