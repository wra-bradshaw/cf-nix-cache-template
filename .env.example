# Set this only in the Deploy button / Workers Builds secret environment.
# It is read from memory and is never written to this repository.
CF_NIX_CACHE_BOOTSTRAP_SECRET=replace-with-a-long-random-value

# Optional when a private mirror is required. The value must contain @sha256:.
# CF_NIX_CACHE_PROCESSOR_IMAGE=docker.io/willlol/cf-nix-cache@sha256:...
